---
// index.astro — Home page: bio, featured projects, recent writing, elsewhere links, footer.
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingEntry from '../components/WritingEntry.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

// Pull thoughts/papers from the same content collection the /thoughts page uses,
// so both views stay consistent. Show the most recent few here.
const recentThoughts = (await getCollection('thoughts'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  const month = d.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
  const year = d.getUTCFullYear().toString().slice(2);
  return `${month} '${year}`;
}
---
<Base title="Ojasw Upadhyay" wide>
  <!-- Bio -->
  <section class="intro">
    <h1>
      Ojasw Upadhyay
    </h1>
    <p class="byline">
      Software Engineer at YouTube · Georgia Tech '25
    </p>
    <p class="bio">
      I build things at the intersection of AI, design, and intuitive interfaces.
      Currently working on AI Dubbing at
      <a class="inline-link" href="https://youtube.com" style="--deco-color: var(--deco-red)">YouTube</a>.
      Previously: two internships at
      <a class="inline-link" href="https://google.com" style="--deco-color: var(--deco-lime)">Google</a>,
      and AI safety research at
      <a class="inline-link" href="https://gatech.edu" style="--deco-color: var(--deco-yellow)">Georgia Tech</a>.
    </p>
  </section>

  <!-- Projects -->
  <section class="home-section">
    <SectionHeader label="Projects" />
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          href={project.href}
          tags={project.tags}
          visual={project.visual}
          index={index + 1}
          total={projects.length}
        />
      ))}
    </div>
  </section>

  <!-- Thoughts -->
  <section class="home-section">
    <SectionHeader label="Thoughts" />
    <div>
      {recentThoughts.map(post => (
        <WritingEntry
          title={post.data.title}
          date={formatDate(post.data.date)}
          href={post.data.url ?? `/thoughts/${post.id}`}
          external={!!post.data.url}
          tags={post.data.tags ?? []}
          tagTooltips={post.data.tagTooltips ?? {}}
        />
      ))}
    </div>
  </section>

  <Footer />
</Base>

<style>
  .intro {
    max-width: 42.5rem;
  }

  h1 {
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .byline {
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .bio {
    margin: 0;
    max-width: 40rem;
  }

  .home-section {
    margin-top: var(--section-gap);
  }

  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(15rem, 0.9fr);
    gap: var(--card-gap);
  }

  @media (max-width: 700px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
