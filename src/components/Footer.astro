---
// Footer.astro — Minimal footer with social links and colophon.
const links = [
  { href: 'https://link.ojasw.dev/resume', label: 'Resume' },
  { href: 'https://github.com/oupadhyay', label: 'GitHub' },
  { href: 'https://scholar.google.com/citations?user=nPogjt0AAAAJ', label: 'Scholar' },
  { href: 'https://linkedin.com/in/ojasw', label: 'LinkedIn' },
];
---
<footer class="footer">
  <div class="footer-links">
    {links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer" class="footer-link">
        {link.label}<span class="arrow">↗</span>
      </a>
    ))}
  </div>
  <p class="colophon">Set in Instrument Serif, Geist & Ioskeley Mono.</p>
</footer>

<style is:global>
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: var(--section-gap);
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-border);
  }
  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .footer-link {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .footer-link:hover {
    color: var(--color-text-primary);
  }
  .footer-link .arrow {
    display: inline-block;
    font-size: 0.7em;
    margin-left: 0.15em;
    transition: transform 200ms ease;
  }
  .footer-link:hover .arrow {
    transform: translate(2px, -2px);
  }
  .colophon {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    text-align: right;
  }

  @media (max-width: 700px) {
    .footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }

    .footer-links {
      width: 100%;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .colophon {
      text-align: left;
    }
  }
</style>
